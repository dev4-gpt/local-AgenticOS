ARG NODE_VERSION=24.14.1-slim

FROM node:${NODE_VERSION} AS dependencies
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

FROM node:${NODE_VERSION} AS builder
WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules
COPY . .
ENV NODE_ENV=production
ENV VELOCE_CONTAINER_BUILD=1
ENV VELOCE_CLIENT_EDITION=1
ENV AGENTIC_OS_DISABLE_LOCAL_CLI=1
ENV AGENTIC_OS_DISABLE_LOCAL_FILES=1
ENV AGENTIC_OS_REQUIRE_APPROVALS=1
RUN npm run build
RUN node scripts/prune-client-runtime-artifact.mjs
RUN node scripts/verify-client-runtime-build-trace.mjs

FROM node:${NODE_VERSION} AS runner
ARG VELOCE_SOURCE_COMMIT=unverified
WORKDIR /app
ENV NODE_ENV=production
ENV VELOCE_BUILD_SOURCE_COMMIT=${VELOCE_SOURCE_COMMIT}
LABEL org.opencontainers.image.revision=${VELOCE_SOURCE_COMMIT}
ENV PORT=8080
ENV HOSTNAME=0.0.0.0
ENV VELOCE_CLIENT_EDITION=1
ENV AGENTIC_OS_DISABLE_LOCAL_CLI=1
ENV AGENTIC_OS_DISABLE_LOCAL_FILES=1
ENV AGENTIC_OS_REQUIRE_APPROVALS=1
ENV CLIENT_RUNTIME_ENFORCE_AUTH=1
ENV CLIENT_ALLOWED_ROUTES=/,/context,/orchestrate,/create,/credentials,/capabilities,/deliver,/paperclip,/room,/pipeline,/claude,/openclaw,/hermes,/antigravity,/codex,/kimi,/glm,/glm-code,/grok,/freeclaude,/fusion,/sakana,/local,/engine,/agent-kanban,/loop,/ruflo,/goals,/journal,/seo,/seo-guide,/opendesign,/web-studio,/flow-lab,/integrations,/video,/studio,/openmontage,/music,/games,/thumbnails,/notebook,/kanban,/memory,/leads,/radar,/guide,/provider-matrix
ENV CLIENT_ALLOWED_API_ROUTES=/api/capabilities,/api/speech/transcribe,/api/client-runtime/credentials,/api/client-runtime/credits,/api/client-runtime/credits/checkout,/api/client-runtime/credential-submissions,/api/client-runtime/requests,/api/client-runtime/artifacts,/api/client-runtime/visual-qa,/api/client-runtime/hosted-jobs,/api/client-runtime/executions,/api/client-runtime/delivery,/api/client-runtime/records,/api/client-runtime/skills,/api/client-runtime/learning,/api/client-runtime/ecc,/api/client-runtime/workflows,/api/client-runtime/jobs,/api/client-runtime/memory-import,/api/client-runtime/source-import,/api/client-runtime/memory-graph,/api/client-runtime/build-identity,/api/internal/client-runtime/jobs,/api/internal/client-runtime/dispatch,/api/internal/client-runtime/delivery,/api/client-auth/session,/api/client-runtime/manifest-proposals
COPY --from=builder --chown=node:node /app/public ./public
COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static
COPY --from=builder --chown=node:node /app/scripts/run-client-workspace-job.mjs ./scripts/run-client-workspace-job.mjs
USER node
EXPOSE 8080
CMD ["node", "server.js"]

# Copy to a private path such as:
#   .private-client-kits/acme.local.env
#
# Never commit the copied file. The repo .gitignore excludes .env* and
# .private-client-kits/.

CLIENT_SLUG=local-test
CLIENT_NAME=Local Test Runtime
CLIENT_ALLOWED_USER_EMAILS=your-login-email@example.com

# Provider credentials for local 3939 testing. Leave blank until you are ready.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_MUSIC_API_KEY=
HEYGEN_API_KEY=
SUNO_API_KEY=
GLM_API_KEY=
SAKANA_API_KEY=
FIRECRAWL_API_KEY=
HUNTER_API_KEY=

# Optional Supabase client/runtime metadata.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# The client edition is authenticated at the application layer. Keep this on
# for local tests so the local test matches the approved Cloud Run contract.
CLIENT_RUNTIME_ENFORCE_AUTH=1
CLIENT_ALLOWED_ROUTES=/,/provider-catalog,/credits,/context,/orchestrate,/create,/credentials,/capabilities,/deliver,/paperclip,/room,/pipeline,/claude,/openclaw,/hermes,/antigravity,/codex,/kimi,/glm,/glm-code,/grok,/freeclaude,/fusion,/sakana,/local,/engine,/agent-kanban,/loop,/ruflo,/goals,/journal,/seo,/opendesign,/web-studio,/flow-lab,/integrations,/video,/studio,/openmontage,/music,/games,/thumbnails,/notebook,/kanban,/memory,/leads,/radar,/guide
CLIENT_ALLOWED_API_ROUTES=/api/capabilities,/api/client-runtime/credentials,/api/client-runtime/credits,/api/client-runtime/credits/checkout,/api/client-runtime/manifest-proposals,/api/client-runtime/credential-submissions,/api/client-runtime/requests,/api/client-runtime/artifacts,/api/client-runtime/hosted-jobs,/api/client-runtime/delivery,/api/client-runtime/build-identity,/api/client-runtime/records,/api/client-runtime/workflows,/api/client-runtime/provider-chat,/api/client-runtime/source-import,/api/client-runtime/source-import/upload,/api/client-runtime/jobs,/api/internal/client-runtime/jobs,/api/internal/client-runtime/delivery,/api/client-auth/session
CLIENT_ENABLED_CAPABILITIES=tenant-data,orchestration,web-studio,design-intelligence,immersive-scroll-site,asset-sequencing,flow-lab,knowledge,delivery,quality
CLIENT_PROVIDER_ALLOWLIST=ANTHROPIC_API_KEY,OPENAI_API_KEY,OPENROUTER_API_KEY,ELEVENLABS_API_KEY,ELEVENLABS_MUSIC_API_KEY,HEYGEN_API_KEY,SUNO_API_KEY,GLM_API_KEY,SAKANA_API_KEY,FIRECRAWL_API_KEY,HUNTER_API_KEY,SUPABASE_URL,SUPABASE_ANON_KEY
CLIENT_BUDGET_CAP=100
CLIENT_BUDGET_WARNING_THRESHOLD=80
CLIENT_APPROVAL_POLICY=approve_external_actions
CLIENT_STORAGE_NAMESPACE=local-test
CLIENT_RETENTION_DAYS=45

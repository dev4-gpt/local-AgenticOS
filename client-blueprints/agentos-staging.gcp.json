{
  "schemaVersion": 1,
  "purpose": "Staging client runtime for tenant agentos-staging, used to show the Adapters page (demo adapter zz-demo-creator). No provider calls.",
  "clientSlug": "agentos-staging",
  "clientName": "Veloce AgentOS Staging",
  "approved": false,
  "approvalOwner": "Aryaman",
  "acknowledgeClientSafeRuntime": true,
  "providerCallsEnabled": false,
  "intentRoutingEnabled": false,
  "provisioning": { "phase": "prepare" },
  "gcp": {
    "projectId": "veloce-agenticos-2026",
    "region": "asia-south1",
    "serviceName": "veloce-agentos-staging",
    "runtimeServiceAccount": "veloce-agentos-stg-run",
    "workspaceJobName": "veloce-agentos-stg-workspace",
    "visualQaJobName": "veloce-agentos-stg-visualqa",
    "storageBucket": "veloce-agenticos-2026-veloce-agentos-staging",
    "artifactRegistryRepository": "veloce",
    "image": "asia-south1-docker.pkg.dev/veloce-agenticos-2026/veloce/client-runtime:REPLACE_WITH_BUILT_TAG",
    "minInstances": 0,
    "maxInstances": 1,
    "cpu": "1",
    "memory": "1Gi",
    "concurrency": 1,
    "timeout": "900s"
  },
  "access": {
    "mode": "app-auth",
    "allowedUserEmails": ["REPLACE_WITH_THE_TWO_STAGING_ACCOUNT_EMAILS"]
  },
  "runtimeEnv": {
    "VELOCE_CLIENT_EDITION": "1",
    "AGENTIC_OS_DISABLE_LOCAL_CLI": "1",
    "AGENTIC_OS_DISABLE_LOCAL_FILES": "1",
    "AGENTIC_OS_REQUIRE_APPROVALS": "1",
    "CLIENT_RUNTIME_ENFORCE_AUTH": "1",
    "CLIENT_RUNTIME_WORKER_ENABLED": "0",
    "SUPABASE_URL": "https://edxznuovrevymmdvbarb.supabase.co",
    "CLIENT_RUNTIME_DATA_MODE": "supabase"
  },
  "optionalSurfaces": ["adapters"],
  "enabledCapabilities": ["tenant-data", "artifacts", "orchestration", "quality"],
  "enabledTraits": [],
  "providerAllowlist": ["SUPABASE_ANON_KEY"],
  "modelAllowlist": [],
  "budget": { "monthlyCap": "1", "warningThreshold": "0.5" },
  "approvalPolicy": "approve_external_actions",
  "storage": { "namespace": "agentos-staging", "corsOrigins": ["https://app.veloceos.cloud"] },
  "retention": { "days": 1 },
  "secretEnv": { "SUPABASE_ANON_KEY": "supabase-anon-key" },
  "notes": "approved is false on purpose: the provisioner refuses --apply until you set it. Before apply: (1) replace the image tag and the two emails, (2) optionalSurfaces turns on /adapters for this client only, (3) you add the staging Supabase anon-key secret version yourself. Dry-run first: npm run provision:gcp-client -- --config client-blueprints/agentos-staging.gcp.json --phase prepare"
}

# Veloce edition — lead capture (copy to .env.local and fill in).
# Both values are in Supabase → Project Settings → API.
#
#   SUPABASE_URL              = "Project URL"  (e.g. https://abcdefgh.supabase.co)
#   SUPABASE_SERVICE_ROLE_KEY = "service_role" secret key  (NOT the anon key)
#
# The service_role key bypasses RLS and MUST stay server-side only — never commit it.
# Until both are set, /api/lead returns "not_configured" and the form falls back
# to a copy-brief handoff so no lead is lost.
#
# /api/deployment-request uses the same env vars to insert into the
# deployment_requests table. Run supabase-deployment-requests.sql in Supabase
# before enabling the gated runtime intake store.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Resend notification for every stored public lead and runtime request.
# Create a Resend API key and verify the domain used in the From address first.
# These values belong in Vercel Production only; never commit a real API key.
RESEND_API_KEY=
LEAD_NOTIFICATION_FROM=
LEAD_NOTIFICATION_TO=

# Origin the chapter cards deep-link into (the main Veloce AgenticOS
# workspace app). Defaults to http://127.0.0.1:3939 for local dev.
# Set this to the deployed workspace URL in production.
NEXT_PUBLIC_APP_URL=

# Optional approved runtime link for a single local/cloud test client.
NEXT_PUBLIC_CLIENT_RUNTIME_URL=

# Set to 1 only for an owner-only Vercel test that opens this machine's
# localhost runtime. Other visitors cannot reach your localhost.
NEXT_PUBLIC_ALLOW_LOCAL_CLIENT_RUNTIME_LINK=0

# Explicit non-secret billing mode. Test is the safe default; live requires
# separate live Stripe keys and webhook signing configuration.
STRIPE_MODE=test

# Cloudflare Turnstile for the public onboarding form. Keep the site key public
# and the secret server-side. Leave both blank until the widget is configured.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

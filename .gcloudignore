# Cloud Build receives the source tree, not the local build cache. Keep the
# upload limited to files that Dockerfile.client can actually compile.
.git/
.vercel/
**/.vercel/
.next/
.next-*/
**/.next/
node_modules/
**/node_modules/
public-site/
product-experience/.next/
product-experience/public/
**/dist/
test-results/
tmp/
.private-client-kits/
.claude-flow/
.swarm/
.netlify/
docs/
tests/
*.log
.DS_Store

# Never upload workstation configuration or credentials to Cloud Build.
.env
.env.*
**/.env
**/.env.*
*.pem
*.key
*.p12
*.pfx

# AgentOS local environment example.
# Copy to .env.local for local overrides only. Never commit .env.local or real keys.

AGENTIC_OS_VAULT=/Users/you/Documents/ObsidianVault
AGENTIC_OS_CONFIG=/Users/you/.agentic-os/config.json

# Optional provider keys. Prefer local private files such as:
# - ~/.hermes/profiles/<active>/.env for Hermes/OpenRouter/ElevenLabs keys
# - ~/.agentic-os/*.env for feature-specific keys
#
# OPENROUTER_API_KEY=
# Groq Speech-to-Text for all recorded microphone inputs. Keep server-side.
# GROQ_API_KEY=

# Native server-side traits. This is a manifest switch, not a user-facing skill.
# CLIENT_ENABLED_TRAITS=context-compression
# CLIENT_INTENT_ROUTING_ENABLED=1
# ELEVENLABS_API_KEY=
# Optional separate key for Eleven Music. Keep this separate from the voice/OpenMontage key.
# ELEVENLABS_MUSIC_API_KEY=

# Optional business integrations. Prefer the private Integrations page, which writes
# these values to ~/.agentic-os/integrations.json with 0600 permissions.
# PLAUSIBLE_BASE_URL=
# PLAUSIBLE_DOMAIN=
# PLAUSIBLE_API_KEY=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# CALCOM_URL=
# LISTMONK_URL=
# LISTMONK_USERNAME=
# LISTMONK_PASSWORD=
# GHOST_URL=
# GHOST_ADMIN_API_KEY=
# STIRLING_PDF_URL=
# PENPOT_URL=
# FIRECRAWL_API_KEY=
# HUNTER_API_KEY=
# APOLLO_API_KEY=
# Optional privacy-safe product analytics and runtime diagnostics. These are
# server-only values; never expose them as NEXT_PUBLIC_* variables.
# POSTHOG_HOST=https://app.posthog.com
# POSTHOG_API_KEY=
# Enable only after consent, destination, and retention review.
# CLIENT_POSTHOG_CAPTURE_ENABLED=0
# SENTRY_DSN=
# VELOCE_RELEASE=

# Stripe mode is an explicit non-secret deployment setting. Keep Test mode for
# sandbox cards; switch to live only with live Stripe keys, webhooks, refunds,
# monitoring, and an approved production release checklist.
# STRIPE_MODE=test

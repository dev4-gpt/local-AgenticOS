.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env.local
.env

# ruflo/claude-flow runtime data — never ship or commit (audit #12)
.claude-flow/
member-pack/.claude-flow/
.swarm/

# Local Netlify folder
.netlify

# Runtime/generated media outputs
public/openmontage/generated/

# Local high-resolution masters for public Veloce art. The optimized JPG assets
# are the only variants shipped with the public-site source.
/public-site/assets/
public-site/src/assets/*.png

# Private client material. Keep proposals, approvals, vault exports, usage reports,
# and delivery workspaces outside the public AgentOS repository.
.private-client-kits/

# iCloud duplicate files. This repo lives in iCloud Drive, which resurrects
# deleted files as "name 2.ext" -- including stale copies of real source, e.g. a
# July snapshot of src/app/page.tsx. They were previously suppressed in
# .git/info/exclude, which is local to one clone, so every other checkout (and
# the parallel Codex session) still saw them as untracked noise.
*[[:space:]]2.*
# ...and the extensionless form. The pattern above requires a dot after the 2,
# so it silently missed ".gcloudignore 2", which has no extension.
*[[:space:]]2

# Generated pitch-deck output (~10 MB). Every file under it is produced by
# scripts/create-local-product-pitch-deck.mjs — the HTML, the PDF, and the
# assets/, which are authenticated Playwright screenshots of the *private* local
# runtime on 3939. Rebuild it rather than committing it. The rest of
# launch-system/ is tracked source and stays tracked.
launch-system/pitch-deck-local-product/

# Ad-hoc knowledge-graph/diagram tooling output (graphify, archify). Regenerate
# on demand rather than committing — these are exploration aids, not source.
graphify-out/
docs/architecture/diagrams/

    "verify:health": "node scripts/verify-live-health.mjs",
    "verify:security": "node scripts/verify-security-release.mjs",
    "verify:secrets": "node scripts/verify-repository-secrets.mjs",
    "verify:flow-lab": "node scripts/verify-flow-lab.mjs",
    "record:reference": "node scripts/record-reference-scroll.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/js-yaml": "^4.0.9",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.38.0",
    "highlight.js": "^11.11.1",
    "js-yaml": "^4.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-force-graph-3d": "^1.29.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "three": "^0.184.0",
    "three-spritetext": "^1.10.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",

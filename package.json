{
  "name": "agentic-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-next-dev.mjs",
    "dev:v0": "env VELOCE_DIST_DIR=.next-v0 PORT=3737 node scripts/run-next-dev.mjs",
    "dev:workspace": "env PORT=3939 node scripts/run-next-dev.mjs",
    "dev:operator-runtime": "node scripts/run-operator-runtime-local.mjs",
    "dev:client-runtime": "node scripts/run-client-runtime-local.mjs",
    "dev:landing": "npm --prefix public-site run dev",
    "dev:experience": "npm --prefix product-experience run dev",
    "build": "next build",
    "build:v0": "env VELOCE_DIST_DIR=.next-v0 next build",
    "start": "next start -H 127.0.0.1",
    "start:v0": "env VELOCE_DIST_DIR=.next-v0 PORT=3737 next start -H 127.0.0.1",
    "start:workspace": "next start -H 127.0.0.1 -p 3939",
    "start:cloud": "next start -H 0.0.0.0",
    "start:landing": "npm --prefix public-site run preview",
    "start:experience": "npm --prefix product-experience run start",
    "verify:v1": "npm run build && npx playwright test tests/sidebar-smoke.spec.ts --reporter=line",
    "verify:product": "npm run build && npx playwright test tests/sidebar-smoke.spec.ts tests/visual-shell.spec.ts --reporter=line && npm run verify:health && npm run verify:flow-lab && npm run verify:security",
    "verify:health": "node scripts/verify-live-health.mjs",
    "verify:models": "node scripts/verify-model-chats.mjs",
    "verify:security": "node scripts/verify-security-release.mjs && node scripts/verify-client-provider-policy.mjs && node scripts/verify-client-lifecycle.mjs",
    "verify:secrets": "node scripts/verify-repository-secrets.mjs",
    "verify:flow-lab": "node scripts/verify-flow-lab.mjs",
    "verify:client-runtime": "node scripts/verify-client-runtime.mjs",
    "verify:client-authenticated": "node scripts/verify-client-runtime-authenticated.mjs",
    "verify:client-worker": "node scripts/verify-client-runtime-worker.mjs",
    "verify:client-surface-map": "node scripts/verify-client-runtime-surface-map.mjs",
    "verify:client-provider-policy": "node scripts/verify-client-provider-policy.mjs",
    "verify:client-lifecycle": "node scripts/verify-client-lifecycle.mjs",
    "verify:client-isolation": "node scripts/verify-client-runtime-isolation.mjs",
    "client:lifecycle": "node scripts/client-lifecycle.mjs",
    "provision:runtime-alerts": "node scripts/provision-client-runtime-alerts.mjs",
    "validate:client-manifest": "node scripts/validate-client-manifest.mjs",
    "promote:client-credential": "node scripts/promote-client-credential.mjs",
    "provision:client-worker-token": "node scripts/provision-client-worker-token.mjs",
    "approve:client-delivery": "node scripts/approve-client-delivery.mjs",
    "verify:experience": "npm --prefix product-experience run build && npx playwright test tests/product-experience.spec.ts --reporter=line",
    "provision:gcp-client": "node scripts/provision-gcp-client.mjs",
    "build:client-image": "gcloud builds submit --config cloudbuild.client.yaml --substitutions=_IMAGE=$CLIENT_IMAGE .",
    "record:reference": "node scripts/record-reference-scroll.mjs"
  },
  "engines": {
    "node": ">=22 <26"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/js-yaml": "^4.0.9",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.38.0",
    "highlight.js": "^11.11.1",
    "js-yaml": "^4.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-force-graph-3d": "^1.29.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "three": "^0.184.0",
    "three-spritetext": "^1.10.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "postcss": "8.5.22",
    "sharp": "0.35.3"
  }
}

{
  "name": "agentic-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --disable-source-maps -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "verify:v1": "npm run build && npx playwright test tests/sidebar-smoke.spec.ts --reporter=line",
